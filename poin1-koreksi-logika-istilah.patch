diff --git a/tests/Feature/AdminPembinaBukanSiswaTest.php b/tests/Feature/AdminPembinaBukanSiswaTest.php
new file mode 100644
index 0000000..105ec04
--- /dev/null
+++ b/tests/Feature/AdminPembinaBukanSiswaTest.php
@@ -0,0 +1,151 @@
+<?php
+
+use App\Models\EkskulPengunduranDiri;
+use App\Models\Ekstrakurikuler;
+use App\Models\PendaftaranEkskul;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    $this->withoutVite();
+});
+
+function akunPeran(string $role, ?string $nama = null): User
+{
+    return User::factory()->create(array_filter([
+        'name' => $nama,
+        'role' => $role,
+        'is_active' => true,
+    ]));
+}
+
+function ekskulPeran(string $nama = 'Futsal'): Ekstrakurikuler
+{
+    return Ekstrakurikuler::create([
+        'nama_ekstrakurikuler' => $nama,
+        'pembina' => 'Pak Budi',
+        'status' => 'aktif',
+    ]);
+}
+
+function daftarPeran(User $user, Ekstrakurikuler $ekskul, string $status = 'diterima'): PendaftaranEkskul
+{
+    return PendaftaranEkskul::create([
+        'user_id' => $user->id,
+        'ekstrakurikuler_id' => $ekskul->id,
+        'nama_pendaftar' => $user->name,
+        'peran' => 'siswa',
+        'status' => $status,
+        'status_anggota' => 'aktif',
+    ]);
+}
+
+// ---------------------------------------------------------------------------
+// Ganti role: admin & pembina bukan siswa
+// ---------------------------------------------------------------------------
+
+test('siswa yang dinaikkan jadi pembina atau admin kehilangan keanggotaan ekskul aktifnya', function (string $roleBaru) {
+    $admin = akunPeran('admin');
+    $siswa = akunPeran('siswa', 'Budi');
+    $futsal = ekskulPeran('Futsal');
+    $silat = ekskulPeran('Silat');
+
+    $p1 = daftarPeran($siswa, $futsal);
+    $p2 = daftarPeran($siswa, $silat);
+
+    $this->actingAs($admin)
+        ->patch(route('users.updateRole', $siswa), ['role' => $roleBaru])
+        ->assertSessionHas('success', fn ($pesan) => str_contains($pesan, 'diakhiri'));
+
+    foreach ([$p1, $p2] as $p) {
+        $p->refresh();
+        expect($p->status_anggota)->toBe('keluar')
+            ->and($p->tanggal_keluar)->not->toBeNull()
+            ->and($p->status)->toBe('diterima');   // riwayat pendaftaran tetap tersimpan
+    }
+
+    expect(PendaftaranEkskul::anggotaAktif()->where('user_id', $siswa->id)->count())->toBe(0);
+    expect($siswa->notifications()->get()->map(fn ($n) => $n->data['judul'] ?? null)->all())
+        ->toContain('Keanggotaan ekskul diakhiri');
+})->with(['pembina', 'admin']);
+
+test('pengajuan keluar yang masih menunggu ikut ditutup saat siswa jadi staf', function () {
+    $admin = akunPeran('admin');
+    $siswa = akunPeran('siswa');
+    $ekskul = ekskulPeran();
+    $p = daftarPeran($siswa, $ekskul);
+
+    $pengajuan = EkskulPengunduranDiri::create([
+        'ekstrakurikuler_id' => $ekskul->id,
+        'user_id' => $siswa->id,
+        'pendaftaran_id' => $p->id,
+        'peran' => 'anggota',
+        'jenis' => 'mengundurkan_diri',
+        'alasan' => 'Fokus ujian',
+    ]);
+
+    $this->actingAs($admin)->patch(route('users.updateRole', $siswa), ['role' => 'pembina']);
+
+    expect($pengajuan->refresh()->status)->toBe('disetujui')
+        ->and($pengajuan->diputuskan_oleh)->toBe($admin->id);
+});
+
+test('mengubah role ke siswa tidak menyentuh keanggotaan', function () {
+    $admin = akunPeran('admin');
+    $siswa = akunPeran('siswa');
+    $p = daftarPeran($siswa, ekskulPeran());
+
+    $this->actingAs($admin)->patch(route('users.updateRole', $siswa), ['role' => 'siswa']);
+
+    expect($p->refresh()->status_anggota)->toBe('aktif');
+});
+
+test('pendaftaran pending milik akun yang sekarang staf tidak bisa diterima', function () {
+    $admin = akunPeran('admin');
+    $pembina = akunPeran('pembina');
+    $ekskul = ekskulPeran();
+    $p = daftarPeran($pembina, $ekskul, 'pending');
+
+    $this->actingAs($admin)
+        ->patch(route('pendaftaran.updateStatus', $p), ['status' => 'diterima'])
+        ->assertSessionHas('error', fn ($pesan) => str_contains($pesan, 'bukan siswa'));
+
+    expect($p->refresh()->status)->toBe('pending');
+
+    // Menolaknya tetap boleh
+    $this->actingAs($admin)
+        ->patch(route('pendaftaran.updateStatus', $p), ['status' => 'ditolak'])
+        ->assertSessionHas('success');
+
+    expect($p->refresh()->status)->toBe('ditolak');
+});
+
+test('admin dan pembina tidak bisa mendaftar ekskul', function (string $role) {
+    $staf = akunPeran($role);
+    $ekskul = ekskulPeran();
+
+    $this->actingAs($staf)
+        ->post(route('pendaftaran.store'), ['ekstrakurikuler_id' => $ekskul->id])
+        ->assertSessionHas('error', fn ($pesan) => str_contains($pesan, 'tidak mendaftar ekskul'));
+
+    expect(PendaftaranEkskul::count())->toBe(0);
+})->with(['admin', 'pembina']);
+
+// ---------------------------------------------------------------------------
+// Istilah: PR diseragamkan menjadi "Task"
+// ---------------------------------------------------------------------------
+
+test('tab materi memakai istilah Task, bukan PR', function () {
+    $admin = akunPeran('admin');
+    $ekskul = ekskulPeran();
+
+    $this->actingAs($admin)
+        ->get(route('ekstrakurikuler.show', ['id' => $ekskul->id, 'tab' => 'materi']))
+        ->assertOk()
+        ->assertSee('Buat Task')
+        ->assertSee('Belum ada Task.')
+        ->assertDontSee('Buat PR')
+        ->assertDontSee('Belum ada PR');
+});
