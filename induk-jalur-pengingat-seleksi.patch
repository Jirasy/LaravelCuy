diff --git a/tests/Feature/IndukOrganisasiTest.php b/tests/Feature/IndukOrganisasiTest.php
new file mode 100644
index 0000000..4c78162
--- /dev/null
+++ b/tests/Feature/IndukOrganisasiTest.php
@@ -0,0 +1,142 @@
+<?php
+
+use App\Models\Ekstrakurikuler;
+use App\Models\JenisEkskul;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    $this->withoutVite();
+});
+
+function adminIo(): User
+{
+    return User::factory()->create(['role' => 'admin', 'is_active' => true]);
+}
+
+function ekskulIo(string $nama, string $tipe = 'organisasi', array $tambahan = []): Ekstrakurikuler
+{
+    return Ekstrakurikuler::create(array_merge([
+        'nama_ekstrakurikuler' => $nama,
+        'pembina' => 'Pak Uji',
+        'status' => 'aktif',
+        'jenis_ekskul_id' => JenisEkskul::where('kode', $tipe)->value('id'),
+    ], $tambahan));
+}
+
+function formIo(Ekstrakurikuler $ekskul, array $tambahan = []): array
+{
+    return array_merge([
+        'nama_ekstrakurikuler' => $ekskul->nama_ekstrakurikuler,
+        'pembina' => 'Pak Uji',
+        'status' => 'aktif',
+        'jenis_ekskul_id' => $ekskul->jenis_ekskul_id,
+        'hari' => ['senin'],
+        'jadwal' => ['senin' => ['jam_mulai' => '15:00', 'jam_selesai' => '17:00']],
+    ], $tambahan);
+}
+
+test('admin menempatkan OSIS di bawah MPK, dan MPK tercatat membawahi OSIS', function () {
+    $mpk = ekskulIo('MPK');
+    $osis = ekskulIo('OSIS');
+
+    $this->actingAs(adminIo())->put(route('ekstrakurikuler.update', $osis->id), formIo($osis, ['induk_id' => $mpk->id]))
+        ->assertSessionHasNoErrors();
+
+    expect($osis->fresh()->induk_id)->toBe($mpk->id)
+        ->and($osis->fresh()->induk->nama_ekstrakurikuler)->toBe('MPK')
+        ->and($mpk->bawahan()->pluck('nama_ekstrakurikuler')->all())->toBe(['OSIS']);
+});
+
+test('induk bisa dilepas dengan mengosongkan pilihan', function () {
+    $mpk = ekskulIo('MPK');
+    $osis = ekskulIo('OSIS', 'organisasi', ['induk_id' => $mpk->id]);
+
+    $this->actingAs(adminIo())->put(route('ekstrakurikuler.update', $osis->id), formIo($osis, ['induk_id' => '']))
+        ->assertSessionHasNoErrors();
+
+    expect($osis->fresh()->induk_id)->toBeNull();
+});
+
+test('induk harus organisasi, bukan dirinya sendiri, dan tidak boleh membentuk lingkaran', function () {
+    $mpk = ekskulIo('MPK');
+    $osis = ekskulIo('OSIS', 'organisasi', ['induk_id' => $mpk->id]);
+    $futsal = ekskulIo('Futsal', 'ekskul');
+    $admin = adminIo();
+
+    // ekskul biasa tidak bisa jadi induk
+    $this->actingAs($admin)->put(route('ekstrakurikuler.update', $osis->id), formIo($osis, ['induk_id' => $futsal->id]))
+        ->assertSessionHasErrors('induk_id');
+
+    // organisasi tidak bisa jadi induk dirinya sendiri
+    $this->actingAs($admin)->put(route('ekstrakurikuler.update', $mpk->id), formIo($mpk, ['induk_id' => $mpk->id]))
+        ->assertSessionHasErrors('induk_id');
+
+    // MPK di bawah OSIS padahal OSIS sudah di bawah MPK = lingkaran
+    $this->actingAs($admin)->put(route('ekstrakurikuler.update', $mpk->id), formIo($mpk, ['induk_id' => $osis->id]))
+        ->assertSessionHasErrors('induk_id');
+
+    expect($mpk->fresh()->induk_id)->toBeNull()->and($osis->fresh()->induk_id)->toBe($mpk->id);
+});
+
+test('induk yang tidak ada ditolak', function () {
+    $osis = ekskulIo('OSIS');
+
+    $this->actingAs(adminIo())->put(route('ekstrakurikuler.update', $osis->id), formIo($osis, ['induk_id' => 99999]))
+        ->assertSessionHasErrors('induk_id');
+});
+
+test('mengganti tipe organisasi menjadi bukan organisasi otomatis melepas induknya', function () {
+    $mpk = ekskulIo('MPK');
+    $osis = ekskulIo('OSIS', 'organisasi', ['induk_id' => $mpk->id]);
+    $biasa = JenisEkskul::where('kode', 'ekskul')->value('id');
+
+    $this->actingAs(adminIo())->put(route('ekstrakurikuler.update', $osis->id), formIo($osis, ['jenis_ekskul_id' => $biasa, 'induk_id' => $mpk->id]))
+        ->assertSessionHasNoErrors();
+
+    expect($osis->fresh()->induk_id)->toBeNull();
+});
+
+test('induk hanya bisa diatur lewat model untuk organisasi: ekskul biasa selalu tanpa induk', function () {
+    $mpk = ekskulIo('MPK');
+    $futsal = ekskulIo('Futsal', 'ekskul', ['induk_id' => $mpk->id]);
+
+    expect($futsal->fresh()->induk_id)->toBeNull();
+});
+
+test('menghapus organisasi induk melepas induk bawahannya, bukan menghapus bawahannya', function () {
+    $mpk = ekskulIo('MPK');
+    $osis = ekskulIo('OSIS', 'organisasi', ['induk_id' => $mpk->id]);
+
+    $mpk->delete();
+
+    expect($osis->fresh())->not->toBeNull()->and($osis->fresh()->induk_id)->toBeNull();
+});
+
+test('halaman ekskul dan katalog menampilkan hierarkinya', function () {
+    $mpk = ekskulIo('MPK');
+    $osis = ekskulIo('OSIS', 'organisasi', ['induk_id' => $mpk->id]);
+    $admin = adminIo();
+
+    $this->actingAs($admin)->get(route('ekstrakurikuler.show', $osis->id))->assertOk()->assertSee('Di bawah MPK');
+    $this->actingAs($admin)->get(route('ekstrakurikuler.show', $mpk->id))->assertOk()->assertSee('Membawahi OSIS');
+    $this->actingAs($admin)->get(route('ekstrakurikuler.index'))->assertOk()->assertSee('Di bawah MPK');
+});
+
+test('form edit menawarkan organisasi lain sebagai induk (bukan dirinya sendiri dan bukan ekskul biasa)', function () {
+    $mpk = ekskulIo('MPK');
+    $osis = ekskulIo('OSIS');
+    ekskulIo('Futsal Garuda', 'ekskul');
+
+    $html = $this->actingAs(adminIo())->get(route('ekstrakurikuler.edit', $osis->id))->assertOk()->getContent();
+
+    expect($html)->toContain('name="induk_id"')
+        ->and($html)->toMatch('/<option value="'.$mpk->id.'"[^>]*>MPK<\/option>/')
+        ->and($html)->not->toMatch('/<option value="'.$osis->id.'"[^>]*>OSIS<\/option>/')
+        ->and($html)->not->toMatch('/<option value="\d+"[^>]*>Futsal Garuda<\/option>/');
+
+    // form tambah ekskul juga punya pilihannya
+    $this->actingAs(adminIo())->get(route('ekstrakurikuler.create'))->assertOk()->assertSee('name="induk_id"', false);
+});
diff --git a/tests/Feature/JalurKelolaUserTest.php b/tests/Feature/JalurKelolaUserTest.php
new file mode 100644
index 0000000..7588a09
--- /dev/null
+++ b/tests/Feature/JalurKelolaUserTest.php
@@ -0,0 +1,233 @@
+<?php
+
+use App\Models\CasisPendaftaran;
+use App\Models\EkskulPembina;
+use App\Models\Ekstrakurikuler;
+use App\Models\JenisEkskul;
+use App\Models\OsisPeriode;
+use App\Models\PendaftaranEkskul;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    $this->withoutVite();
+});
+
+function akunJl(string $role, string $nama): User
+{
+    return User::factory()->create(['role' => $role, 'name' => $nama, 'is_active' => true]);
+}
+
+function ekskulJl(string $nama, string $tipe): Ekstrakurikuler
+{
+    return Ekstrakurikuler::create([
+        'nama_ekstrakurikuler' => $nama, 'pembina' => 'Pak Uji', 'status' => 'aktif',
+        'jenis_ekskul_id' => JenisEkskul::where('kode', $tipe)->value('id'),
+    ]);
+}
+
+function periodeJl(Ekstrakurikuler $ekskul, string $status = 'rekrutmen'): OsisPeriode
+{
+    return OsisPeriode::create(['ekstrakurikuler_id' => $ekskul->id, 'nama' => '2026/2027', 'status' => $status]);
+}
+
+function judulJl(User $user): array
+{
+    return $user->notifications()->get()->map(fn ($n) => $n->data['judul'] ?? null)->all();
+}
+
+function isianJl(array $tambahan = []): array
+{
+    return array_merge(['angkatan' => '2024/2025', 'tahun_mulai' => 2024, 'tahun_selesai' => '', 'status' => 'aktif'], $tambahan);
+}
+
+// OSIS (organisasi, jadi organisasi utama) + Paskibra (ekskul seleksi), masing-masing dengan periode rekrutmen terbuka
+function duaJalurJl(): array
+{
+    $osis = ekskulJl('OSIS', 'organisasi');
+    $paskibra = ekskulJl('Paskibra', 'seleksi');
+
+    return ['osis' => $osis, 'paskibra' => $paskibra, 'periodeOsis' => periodeJl($osis), 'periodePaskibra' => periodeJl($paskibra), 'admin' => akunJl('admin', 'Admin Jalur'), 'siswa' => akunJl('siswa', 'Siswa Jalur')];
+}
+
+test('Kelola User memakai organisasi utama secara bawaan dan jalur lain lewat saringan Jalur seleksi', function () {
+    $d = duaJalurJl();
+
+    $bawaan = $this->actingAs($d['admin'])->get(route('users.index'))->assertOk();
+    $bawaan->assertSee('Masukkan ke jalur CaSis')->assertSee('Kepengurusan OSIS')->assertSee('Catat pengurus OSIS')
+        ->assertSee('name="ekskul_id" value="'.$d['osis']->id.'"', false)
+        ->assertDontSee('Keanggotaan Paskibra');
+
+    $paskibra = $this->actingAs($d['admin'])->get(route('users.index', ['jalur' => $d['paskibra']->id]))->assertOk();
+    $paskibra->assertSee('Masukkan ke jalur Calon Anggota')->assertSee('Keanggotaan Paskibra')->assertSee('Catat anggota Paskibra')
+        ->assertSee('name="ekskul_id" value="'.$d['paskibra']->id.'"', false)
+        ->assertDontSee('Catat pengurus OSIS');
+});
+
+test('jalur yang tidak dikenal kembali ke organisasi utama', function () {
+    $d = duaJalurJl();
+    $biasa = ekskulJl('Futsal', 'ekskul');
+
+    foreach ([99999, $biasa->id] as $id) {
+        $this->actingAs($d['admin'])->get(route('users.index', ['jalur' => $id]))->assertOk()->assertSee('Catat pengurus OSIS');
+    }
+});
+
+test('saringan Jalur seleksi hanya muncul kalau ada lebih dari satu ekskul berseleksi', function () {
+    $osis = ekskulJl('OSIS', 'organisasi');
+    periodeJl($osis);
+    $admin = akunJl('admin', 'Admin Jalur');
+
+    $this->actingAs($admin)->get(route('users.index'))->assertOk()->assertDontSee('id="f-jalur"', false);
+
+    ekskulJl('Paskibra', 'seleksi');
+
+    $this->actingAs($admin)->get(route('users.index'))->assertOk()->assertSee('id="f-jalur"', false)->assertSee('Jalur seleksi');
+});
+
+test('tanpa organisasi, ekskul seleksi pertama menjadi jalur bawaan', function () {
+    $paskibra = ekskulJl('Paskibra', 'seleksi');
+    periodeJl($paskibra);
+    akunJl('siswa', 'Siswa Jalur');   // tombolnya muncul di baris siswa
+
+    $this->actingAs(akunJl('admin', 'Admin Jalur'))->get(route('users.index'))->assertOk()->assertSee('Catat anggota Paskibra');
+});
+
+test('memasukkan siswa ke jalur seleksi ekskul pilihan', function () {
+    $d = duaJalurJl();
+
+    $this->actingAs($d['admin'])->post(route('casis.masukkan', $d['siswa']->id), ['ekskul_id' => $d['paskibra']->id])
+        ->assertSessionHas('success');
+
+    $casis = CasisPendaftaran::firstOrFail();
+
+    expect($casis->osis_periode_id)->toBe($d['periodePaskibra']->id)
+        ->and($casis->status)->toBe('draft')
+        ->and($casis->didaftarkan_oleh)->toBe($d['admin']->id)
+        ->and(judulJl($d['siswa']))->toContain('Kamu didaftarkan ke jalur Paskibra');
+});
+
+test('tanpa ekskul_id, siswa dimasukkan ke jalur organisasi utama', function () {
+    $d = duaJalurJl();
+
+    $this->actingAs($d['admin'])->post(route('casis.masukkan', $d['siswa']->id))->assertSessionHas('success');
+
+    expect(CasisPendaftaran::firstOrFail()->osis_periode_id)->toBe($d['periodeOsis']->id)
+        ->and(judulJl($d['siswa']))->toContain('Kamu didaftarkan ke jalur OSIS');
+});
+
+test('memasukkan ke jalur ditolak kalau periodenya belum dibuka atau siswa sudah anggota', function () {
+    $d = duaJalurJl();
+    $d['periodePaskibra']->update(['status' => 'berjalan']);
+
+    $this->actingAs($d['admin'])->post(route('casis.masukkan', $d['siswa']->id), ['ekskul_id' => $d['paskibra']->id])
+        ->assertSessionHas('error', fn ($m) => str_contains($m, 'Belum ada periode pendaftaran Calon Anggota yang dibuka'));
+
+    PendaftaranEkskul::create([
+        'user_id' => $d['siswa']->id, 'ekstrakurikuler_id' => $d['osis']->id, 'nama_pendaftar' => 'Siswa Jalur',
+        'peran' => 'siswa', 'status' => 'diterima', 'status_anggota' => 'aktif', 'tahun_mulai' => 2026,
+    ]);
+
+    $this->actingAs($d['admin'])->post(route('casis.masukkan', $d['siswa']->id), ['ekskul_id' => $d['osis']->id])
+        ->assertSessionHas('error', fn ($m) => str_contains($m, 'sudah menjadi pengurus OSIS'));
+
+    expect(CasisPendaftaran::count())->toBe(0);
+});
+
+test('mencatat anggota ekskul seleksi tanpa seleksi memakai sebutan anggota; organisasi memakai pengurus', function () {
+    $d = duaJalurJl();
+
+    $this->actingAs($d['admin'])->post(route('casis.pengurus', $d['siswa']->id), isianJl(['ekskul_id' => $d['paskibra']->id, 'catatan' => 'Lupa diinput']))
+        ->assertSessionHas('success', fn ($m) => str_contains($m, 'sekarang anggota Paskibra angkatan 2024/2025'));
+
+    $baris = PendaftaranEkskul::where('user_id', $d['siswa']->id)->firstOrFail();
+
+    expect($baris->ekstrakurikuler_id)->toBe($d['paskibra']->id)
+        ->and($baris->status)->toBe('diterima')
+        ->and($baris->status_anggota)->toBe('aktif')
+        ->and($baris->angkatan_ekskul)->toBe('2024/2025')
+        ->and($baris->dibuat_susulan_oleh)->toBe($d['admin']->id)
+        ->and(judulJl($d['siswa']))->toContain('Kamu menjadi anggota Paskibra');
+
+    $lain = akunJl('siswa', 'Siswa Organisasi');
+    $this->actingAs($d['admin'])->post(route('casis.pengurus', $lain->id), isianJl(['ekskul_id' => $d['osis']->id]))->assertSessionHas('success');
+
+    expect(judulJl($lain))->toContain('Kamu menjadi pengurus OSIS');
+});
+
+test('angkatan susulan yang sama atau dua yang masih menjabat ditolak per ekskul, bukan lintas ekskul', function () {
+    $d = duaJalurJl();
+    $url = route('casis.pengurus', $d['siswa']->id);
+
+    $this->actingAs($d['admin'])->post($url, isianJl(['ekskul_id' => $d['paskibra']->id]))->assertSessionHas('success');
+
+    $this->actingAs($d['admin'])->post($url, isianJl(['ekskul_id' => $d['paskibra']->id]))
+        ->assertSessionHas('error', fn ($m) => str_contains($m, 'sudah tercatat di angkatan 2024/2025'));
+    $this->actingAs($d['admin'])->post($url, isianJl(['ekskul_id' => $d['paskibra']->id, 'angkatan' => '2025/2026', 'tahun_mulai' => 2025]))
+        ->assertSessionHas('error', fn ($m) => str_contains($m, 'anggota Paskibra yang masih menjabat'));
+
+    // angkatan yang sama di ekskul lain (OSIS) tidak bentrok
+    $this->actingAs($d['admin'])->post($url, isianJl(['ekskul_id' => $d['osis']->id]))->assertSessionHas('success');
+
+    expect(PendaftaranEkskul::where('user_id', $d['siswa']->id)->count())->toBe(2);
+});
+
+test('mencatat anggota yang masih menjabat menyelesaikan pendaftaran seleksinya di ekskul itu saja', function () {
+    $d = duaJalurJl();
+    $dipaskibra = CasisPendaftaran::create(['osis_periode_id' => $d['periodePaskibra']->id, 'user_id' => $d['siswa']->id, 'status' => 'draft']);
+    $diOsis = CasisPendaftaran::create(['osis_periode_id' => $d['periodeOsis']->id, 'user_id' => $d['siswa']->id, 'status' => 'draft']);
+
+    $this->actingAs($d['admin'])->post(route('casis.pengurus', $d['siswa']->id), isianJl(['ekskul_id' => $d['paskibra']->id]))->assertSessionHas('success');
+
+    expect($dipaskibra->fresh()->status)->toBe('diterima')->and($diOsis->fresh()->status)->toBe('draft');
+});
+
+test('koreksi kepengurusan bekerja untuk ekskul seleksi dan memakai sebutan keanggotaan', function () {
+    $d = duaJalurJl();
+    $baris = PendaftaranEkskul::create([
+        'user_id' => $d['siswa']->id, 'ekstrakurikuler_id' => $d['paskibra']->id, 'nama_pendaftar' => 'Siswa Jalur',
+        'peran' => 'siswa', 'status' => 'diterima', 'status_anggota' => 'aktif', 'angkatan_ekskul' => '2023/2024', 'tahun_mulai' => 2023,
+    ]);
+
+    $this->actingAs($d['admin'])->patch(route('casis.pengurus.koreksi', $baris->id), isianJl(['angkatan' => '2024/2025', 'status' => 'selesai', 'tahun_selesai' => 2025]))
+        ->assertSessionHas('success', fn ($m) => str_contains($m, 'keanggotaan Paskibra'));
+
+    expect($baris->fresh()->angkatan_ekskul)->toBe('2024/2025')
+        ->and($baris->fresh()->status_anggota)->toBe('selesai')
+        ->and(judulJl($d['siswa']))->toContain('Data keanggotaan Paskibra dikoreksi');
+});
+
+test('pembina hanya bisa mengelola jalur ekskulnya sendiri', function () {
+    $d = duaJalurJl();
+    $pembinaOsis = akunJl('pembina', 'Pembina OSIS');
+    EkskulPembina::create(['ekstrakurikuler_id' => $d['osis']->id, 'user_id' => $pembinaOsis->id, 'mulai' => now()->toDateString()]);
+
+    $this->actingAs($pembinaOsis)->post(route('casis.masukkan', $d['siswa']->id), ['ekskul_id' => $d['paskibra']->id])->assertForbidden();
+    $this->actingAs($pembinaOsis)->post(route('casis.pengurus', $d['siswa']->id), isianJl(['ekskul_id' => $d['paskibra']->id]))->assertForbidden();
+    $this->actingAs($pembinaOsis)->post(route('casis.masukkan', $d['siswa']->id), ['ekskul_id' => $d['osis']->id])->assertSessionHas('success');
+
+    $pembinaPaskibra = akunJl('pembina', 'Pembina Paskibra');
+    EkskulPembina::create(['ekstrakurikuler_id' => $d['paskibra']->id, 'user_id' => $pembinaPaskibra->id, 'mulai' => now()->toDateString()]);
+    $lain = akunJl('siswa', 'Siswa Lain');
+
+    $this->actingAs($pembinaPaskibra)->post(route('casis.pengurus', $lain->id), isianJl(['ekskul_id' => $d['paskibra']->id]))->assertSessionHas('success');
+
+    expect(PendaftaranEkskul::where('user_id', $lain->id)->value('ekstrakurikuler_id'))->toBe($d['paskibra']->id);
+});
+
+test('ekskul_id yang bukan ekskul berseleksi ditolak, begitu pula koreksi baris ekskul biasa', function () {
+    $d = duaJalurJl();
+    $biasa = ekskulJl('Futsal', 'ekskul');
+
+    $this->actingAs($d['admin'])->post(route('casis.masukkan', $d['siswa']->id), ['ekskul_id' => $biasa->id])->assertNotFound();
+    $this->actingAs($d['admin'])->post(route('casis.pengurus', $d['siswa']->id), isianJl(['ekskul_id' => $biasa->id]))->assertNotFound();
+
+    $baris = PendaftaranEkskul::create([
+        'user_id' => $d['siswa']->id, 'ekstrakurikuler_id' => $biasa->id, 'nama_pendaftar' => 'Siswa Jalur',
+        'peran' => 'siswa', 'status' => 'diterima', 'status_anggota' => 'aktif', 'tahun_mulai' => 2025,
+    ]);
+
+    $this->actingAs($d['admin'])->patch(route('casis.pengurus.koreksi', $baris->id), isianJl())->assertNotFound();
+});
diff --git a/tests/Feature/PengingatSeleksiTest.php b/tests/Feature/PengingatSeleksiTest.php
new file mode 100644
index 0000000..13a6e88
--- /dev/null
+++ b/tests/Feature/PengingatSeleksiTest.php
@@ -0,0 +1,202 @@
+<?php
+
+use App\Models\CasisPendaftaran;
+use App\Models\EkskulPembina;
+use App\Models\Ekstrakurikuler;
+use App\Models\JenisEkskul;
+use App\Models\OsisPeriode;
+use App\Models\SeleksiPengingat;
+use App\Models\SeleksiTahap;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Artisan;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    $this->withoutVite();
+});
+
+function akunPg(string $role, string $nama): User
+{
+    return User::factory()->create(['role' => $role, 'name' => $nama, 'is_active' => true]);
+}
+
+// Skenario dasar: ekskul seleksi + periode berstatus seleksi + admin, pembina, senior, dan satu pendaftar yang diajukan
+function skenarioPg(string $statusPeriode = 'seleksi', string $namaEkskul = 'Paskibra Garuda'): array
+{
+    $ekskul = Ekstrakurikuler::create([
+        'nama_ekstrakurikuler' => $namaEkskul, 'pembina' => 'Pak Uji', 'status' => 'aktif',
+        'jenis_ekskul_id' => JenisEkskul::where('kode', 'seleksi')->value('id'),
+    ]);
+    $periode = OsisPeriode::create(['ekstrakurikuler_id' => $ekskul->id, 'nama' => '2026/2027', 'status' => $statusPeriode]);
+
+    $pembina = akunPg('pembina', 'Pembina Uji');
+    EkskulPembina::create(['ekstrakurikuler_id' => $ekskul->id, 'user_id' => $pembina->id, 'mulai' => now()->toDateString()]);
+
+    $senior = akunPg('siswa', 'Senior Uji');
+    $periode->seniors()->attach($senior->id);
+
+    $siswa = akunPg('siswa', 'Calon Uji');
+    $casis = CasisPendaftaran::create(['osis_periode_id' => $periode->id, 'user_id' => $siswa->id, 'motivasi' => str_repeat('Ingin ikut. ', 6), 'status' => 'diajukan']);
+
+    return ['ekskul' => $ekskul, 'periode' => $periode, 'admin' => akunPg('admin', 'Admin Uji'), 'pembina' => $pembina, 'senior' => $senior, 'siswa' => $siswa, 'casis' => $casis];
+}
+
+function tahapPg(OsisPeriode $periode, int $urutan, string $nama, $mulai = null): SeleksiTahap
+{
+    return SeleksiTahap::create([
+        'osis_periode_id' => $periode->id, 'urutan' => $urutan, 'nama' => $nama,
+        'mulai_pada' => $mulai, 'selesai_pada' => $mulai ? $mulai->copy()->addHour() : null, 'tempat' => $mulai ? 'Aula' : null,
+    ]);
+}
+
+function pengingatPg(User $user): array
+{
+    return $user->notifications()->get()->map(fn ($n) => $n->data['judul'] ?? '')->filter(fn ($j) => str_starts_with($j, 'Pengingat seleksi'))->values()->all();
+}
+
+function jalankanPg(): void
+{
+    Artisan::call('seleksi:ingatkan');
+}
+
+test('tahap yang mulai dalam 24 jam diingatkan ke pendaftar dan semua penilai, sekali saja', function () {
+    $d = skenarioPg();
+    tahapPg($d['periode'], 1, 'Tes tulis', now()->addHours(20));
+
+    jalankanPg();
+
+    foreach (['siswa', 'admin', 'pembina', 'senior'] as $peran) {
+        expect(pengingatPg($d[$peran]))->toBe(['Pengingat seleksi: Tes tulis']);
+    }
+
+    $pesan = $d['siswa']->notifications()->first()->data['pesan'];
+    expect($pesan)->toContain('Dalam 24 jam ke depan')->toContain('Paskibra Garuda')->toContain('Aula');
+    expect($d['admin']->notifications()->first()->data['pesan'])->toContain('untuk 1 pendaftar');
+
+    // dijalankan lagi: tidak ada pengingat ganda
+    jalankanPg();
+    jalankanPg();
+
+    expect(pengingatPg($d['siswa']))->toHaveCount(1)->and(pengingatPg($d['admin']))->toHaveCount(1);
+});
+
+test('tahap yang masih lebih dari 24 jam lagi belum diingatkan, lalu diingatkan setelah masuk jendela', function () {
+    $d = skenarioPg();
+    tahapPg($d['periode'], 1, 'Wawancara', now()->addHours(30));
+
+    jalankanPg();
+    expect(pengingatPg($d['siswa']))->toBe([]);
+
+    $this->travel(7)->hours();
+    jalankanPg();
+
+    expect(pengingatPg($d['siswa']))->toBe(['Pengingat seleksi: Wawancara']);
+});
+
+test('tahap yang sudah dekat (kurang dari 1 jam) hanya mendapat satu pengingat, bukan dua', function () {
+    $d = skenarioPg();
+    $tahap = tahapPg($d['periode'], 1, 'Praktik', now()->addMinutes(40));
+
+    jalankanPg();
+    jalankanPg();
+
+    expect(pengingatPg($d['siswa']))->toHaveCount(1)
+        ->and($d['siswa']->notifications()->first()->data['pesan'])->toContain('Kurang dari 1 jam lagi')
+        ->and(SeleksiPengingat::where('seleksi_tahap_id', $tahap->id)->pluck('jenis')->sort()->values()->all())->toBe(['1j', '24j']);
+});
+
+test('pengingat 24 jam lalu 1 jam: dua pengingat berbeda untuk tahap yang sama', function () {
+    $d = skenarioPg();
+    tahapPg($d['periode'], 1, 'Tes tulis', now()->addHours(20));
+
+    jalankanPg();
+    $this->travel(19)->hours();
+    $this->travel(30)->minutes();
+    jalankanPg();
+
+    $pesan = $d['siswa']->notifications()->get()->pluck('data.pesan')->all();
+
+    expect(pengingatPg($d['siswa']))->toHaveCount(2)
+        ->and(collect($pesan)->contains(fn ($p) => str_contains($p, 'Dalam 24 jam ke depan')))->toBeTrue()
+        ->and(collect($pesan)->contains(fn ($p) => str_contains($p, 'Kurang dari 1 jam lagi')))->toBeTrue();
+});
+
+test('hanya pendaftar yang sedang berada di tahap itu yang diingatkan', function () {
+    $d = skenarioPg();
+    $satu = tahapPg($d['periode'], 1, 'Tes tulis');
+    tahapPg($d['periode'], 2, 'Wawancara', now()->addHours(10));
+
+    // satu pendaftar lagi: belum lolos tahap 1; pendaftar utama sudah lolos tahap 1 (sekarang di tahap 2)
+    $belum = akunPg('siswa', 'Calon Belum Lolos');
+    CasisPendaftaran::create(['osis_periode_id' => $d['periode']->id, 'user_id' => $belum->id, 'motivasi' => str_repeat('Ingin ikut. ', 6), 'status' => 'diajukan']);
+    $d['casis']->hasils()->create(['seleksi_tahap_id' => $satu->id, 'hasil' => 'lolos']);
+
+    jalankanPg();
+
+    expect(pengingatPg($d['siswa']))->toBe(['Pengingat seleksi: Wawancara'])
+        ->and(pengingatPg($belum))->toBe([])
+        ->and($d['admin']->notifications()->first()->data['pesan'])->toContain('untuk 1 pendaftar');
+});
+
+test('tidak ada pengingat tanpa jadwal, untuk jadwal yang sudah lewat, periode yang sudah berjalan, atau pendaftar yang sudah ditolak', function () {
+    $d = skenarioPg();
+    tahapPg($d['periode'], 1, 'Tanpa jadwal');
+    tahapPg($d['periode'], 2, 'Sudah lewat', now()->subHours(2));
+
+    $berjalan = skenarioPg('berjalan', 'Ekskul Berjalan');
+    tahapPg($berjalan['periode'], 1, 'Periode selesai', now()->addHours(5));
+
+    $ditolak = skenarioPg('seleksi', 'Ekskul Ditolak');
+    $ditolak['casis']->update(['status' => 'ditolak']);
+    tahapPg($ditolak['periode'], 1, 'Pendaftar ditolak', now()->addHours(5));
+
+    jalankanPg();
+
+    foreach ([$d, $berjalan, $ditolak] as $skenario) {
+        expect(pengingatPg($skenario['siswa']))->toBe([])->and(pengingatPg($skenario['admin']))->toBe([]);
+    }
+});
+
+test('tahap tanpa pendaftar tidak ditandai terkirim, jadi tetap diingatkan begitu ada pendaftar', function () {
+    $d = skenarioPg();
+    $d['casis']->update(['status' => 'draft']);
+    $tahap = tahapPg($d['periode'], 1, 'Tes tulis', now()->addHours(10));
+
+    jalankanPg();
+    expect(SeleksiPengingat::count())->toBe(0);
+
+    $d['casis']->update(['status' => 'diajukan']);
+    jalankanPg();
+
+    expect(pengingatPg($d['siswa']))->toHaveCount(1)->and(SeleksiPengingat::where('seleksi_tahap_id', $tahap->id)->pluck('jenis')->all())->toBe(['24j']);
+});
+
+test('mengubah jadwal tahap menghapus catatan pengingat, jadi jadwal baru diingatkan lagi', function () {
+    $d = skenarioPg();
+    $tahap = tahapPg($d['periode'], 1, 'Tes tulis', now()->addHours(20));
+
+    jalankanPg();
+    expect(pengingatPg($d['siswa']))->toHaveCount(1);
+
+    $this->actingAs($d['admin'])->patch(route('tahap.update', $tahap->id), [
+        'nama' => 'Tes tulis',
+        'mulai_pada' => now()->addHours(10)->format('Y-m-d H:i'),
+        'selesai_pada' => now()->addHours(11)->format('Y-m-d H:i'),
+        'tempat' => 'Lab Komputer',
+    ])->assertSessionHas('success');
+
+    expect(SeleksiPengingat::count())->toBe(0);
+
+    jalankanPg();
+
+    expect(pengingatPg($d['siswa']))->toHaveCount(2)
+        ->and($d['siswa']->notifications()->get()->pluck('data.pesan')->contains(fn ($p) => str_contains($p, 'Lab Komputer')))->toBeTrue();
+});
+
+test('perintah seleksi:ingatkan terdaftar di penjadwal', function () {
+    Artisan::call('schedule:list');
+
+    expect(Artisan::output())->toContain('seleksi:ingatkan');
+});
