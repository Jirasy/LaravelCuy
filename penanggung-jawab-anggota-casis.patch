diff --git a/tests/Feature/PenanggungJawabAnggotaTest.php b/tests/Feature/PenanggungJawabAnggotaTest.php
new file mode 100644
index 0000000..5a0f6f9
--- /dev/null
+++ b/tests/Feature/PenanggungJawabAnggotaTest.php
@@ -0,0 +1,505 @@
+<?php
+
+use App\Models\EkskulJabatan;
+use App\Models\EkskulPengunduranDiri;
+use App\Models\Ekstrakurikuler;
+use App\Models\JenisEkskul;
+use App\Models\PendaftaranEkskul;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    $this->withoutVite();
+});
+
+function akunPj(string $role = 'siswa'): User
+{
+    return User::factory()->create(['role' => $role, 'is_active' => true]);
+}
+
+function ekskulPj(string $nama = 'Robotik Uji', string $kodeJenis = 'ekskul', ?int $indukId = null): Ekstrakurikuler
+{
+    return Ekstrakurikuler::create([
+        'nama_ekstrakurikuler' => $nama,
+        'pembina' => 'Pak Uji',
+        'status' => 'aktif',
+        'jenis_ekskul_id' => (int) JenisEkskul::where('kode', $kodeJenis)->value('id'),
+        'induk_id' => $indukId,
+    ]);
+}
+
+function pendaftarPj(Ekstrakurikuler $ekskul, User $akun, string $status = 'diterima', string $statusAnggota = 'aktif', array $tambahan = []): PendaftaranEkskul
+{
+    return PendaftaranEkskul::create(array_merge([
+        'user_id' => $akun->id,
+        'ekstrakurikuler_id' => $ekskul->id,
+        'nama_pendaftar' => $akun->name,
+        'peran' => 'siswa',
+        'status' => $status,
+        'status_anggota' => $statusAnggota,
+    ], $tambahan));
+}
+
+function pembinaPj(Ekstrakurikuler $ekskul): User
+{
+    $pembina = akunPj('pembina');
+    $ekskul->pembinas()->attach($pembina->id, ['mulai' => now()->toDateString()]);
+
+    return $pembina;
+}
+
+// Anggota ekskul yang ditunjuk (atau tidak) sebagai senior penanggung jawab
+function seniorPj(Ekstrakurikuler $ekskul, bool $ditunjuk = true, string $statusAnggota = 'aktif'): User
+{
+    $senior = akunPj();
+    pendaftarPj($ekskul, $senior, 'diterima', $statusAnggota);
+
+    if ($ditunjuk) {
+        $ekskul->penanggungJawabs()->attach($senior->id);
+    }
+
+    return $senior;
+}
+
+function judulNotifPj(User $akun): array
+{
+    return $akun->notifications()->get()->pluck('data.judul')->all();
+}
+
+// ---------------------------------------------------------------------------
+// Menunjuk dan mencabut penanggung jawab (seperti senior CaSis)
+// ---------------------------------------------------------------------------
+
+test('pembina menunjuk anggota aktif sebagai senior penanggung jawab dan ia diberi tahu', function () {
+    $ekskul = ekskulPj();
+    $pembina = pembinaPj($ekskul);
+    $calon = akunPj();
+    pendaftarPj($ekskul, $calon);
+
+    $this->actingAs($pembina)->post(route('penanggung-jawab.store', $ekskul->id), ['user_id' => $calon->id])
+        ->assertSessionHasNoErrors()->assertSessionHas('success');
+
+    expect($ekskul->penanggungJawabs()->pluck('users.id')->all())->toBe([$calon->id])
+        ->and(DB::table('ekskul_penanggung_jawabs')->value('ditunjuk_oleh'))->toBe($pembina->id)
+        ->and(judulNotifPj($calon))->toContain('Ditunjuk sebagai penanggung jawab anggota');
+});
+
+test('admin juga bisa menunjuk, dan anggota organisasi di atasnya boleh ditunjuk seperti di CaSis', function () {
+    $induk = ekskulPj('Majelis Uji', 'organisasi');
+    $anak = ekskulPj('Organisasi Anak Uji', 'organisasi', $induk->id);
+    $seniorInduk = akunPj();
+    pendaftarPj($induk, $seniorInduk);
+
+    $this->actingAs(akunPj('admin'))->post(route('penanggung-jawab.store', $anak->id), ['user_id' => $seniorInduk->id])
+        ->assertSessionHasNoErrors()->assertSessionHas('success');
+
+    expect($anak->penanggungJawabs()->count())->toBe(1);
+});
+
+test('yang bukan anggota aktif, yang sudah keluar, dan yang sudah ditunjuk ditolak', function () {
+    $ekskul = ekskulPj();
+    $pembina = pembinaPj($ekskul);
+    $luar = akunPj();
+    $keluar = akunPj();
+    pendaftarPj($ekskul, $keluar, 'diterima', 'keluar');
+    $sudah = seniorPj($ekskul);
+
+    foreach ([$luar, $keluar, $sudah] as $calon) {
+        $this->actingAs($pembina)->post(route('penanggung-jawab.store', $ekskul->id), ['user_id' => $calon->id])
+            ->assertSessionHas('error');
+    }
+
+    expect($ekskul->penanggungJawabs()->pluck('users.id')->all())->toBe([$sudah->id]);
+});
+
+test('hanya admin dan pembina ekskul itu yang bisa menunjuk atau mencabut penanggung jawab', function () {
+    $ekskul = ekskulPj();
+    $senior = seniorPj($ekskul);
+    $calon = akunPj();
+    pendaftarPj($ekskul, $calon);
+
+    foreach ([$senior, akunPj(), pembinaPj(ekskulPj('Ekskul Lain Uji'))] as $akun) {
+        $this->actingAs($akun)->post(route('penanggung-jawab.store', $ekskul->id), ['user_id' => $calon->id])->assertForbidden();
+        $this->actingAs($akun)->delete(route('penanggung-jawab.destroy', [$ekskul->id, $senior->id]))->assertForbidden();
+    }
+
+    expect($ekskul->penanggungJawabs()->pluck('users.id')->all())->toBe([$senior->id]);
+});
+
+test('mencabut penugasan menghilangkan haknya seketika dan memberi tahu yang dicabut', function () {
+    $ekskul = ekskulPj();
+    $pembina = pembinaPj($ekskul);
+    $senior = seniorPj($ekskul);
+
+    $this->actingAs(User::find($senior->id))->patch(route('pendaftaran-kontrol.update', $ekskul->id), ['pendaftaran_dibuka' => 1, 'kuota' => 10])->assertSessionHasNoErrors();
+
+    $this->actingAs($pembina)->delete(route('penanggung-jawab.destroy', [$ekskul->id, $senior->id]))->assertSessionHas('success');
+
+    $this->actingAs(User::find($senior->id))->patch(route('pendaftaran-kontrol.update', $ekskul->id), ['pendaftaran_dibuka' => 1, 'kuota' => 99])->assertForbidden();
+
+    expect($ekskul->fresh()->kuota)->toBe(10)
+        ->and(judulNotifPj($senior))->toContain('Penugasan penanggung jawab anggota dicabut');
+});
+
+// ---------------------------------------------------------------------------
+// Kuota dan buka/tutup pendaftaran
+// ---------------------------------------------------------------------------
+
+test('senior penanggung jawab mengatur kuota dan buka/tutup pendaftaran ekskulnya', function () {
+    $ekskul = ekskulPj();
+    $senior = seniorPj($ekskul);
+
+    $this->actingAs($senior)->patch(route('pendaftaran-kontrol.update', $ekskul->id), ['pendaftaran_dibuka' => 0, 'kuota' => 20])
+        ->assertSessionHasNoErrors();
+
+    $ekskul->refresh();
+    expect($ekskul->kuota)->toBe(20)
+        ->and($ekskul->pendaftaran_dibuka)->toBeFalse();
+});
+
+test('senior dari organisasi di atasnya yang ditunjuk juga berhak, selama masih anggota aktif di sana', function () {
+    $induk = ekskulPj('Majelis Uji', 'organisasi');
+    $anak = ekskulPj('Organisasi Anak Uji', 'organisasi', $induk->id);
+    $seniorInduk = akunPj();
+    pendaftarPj($induk, $seniorInduk);
+    $anak->penanggungJawabs()->attach($seniorInduk->id);
+
+    $this->actingAs($seniorInduk)->patch(route('pendaftaran-kontrol.update', $anak->id), ['pendaftaran_dibuka' => 1, 'kuota' => 7])->assertSessionHasNoErrors();
+    expect($anak->fresh()->kuota)->toBe(7);
+
+    // keluar dari organisasi induk: hak hilang
+    PendaftaranEkskul::where('user_id', $seniorInduk->id)->update(['status_anggota' => 'keluar']);
