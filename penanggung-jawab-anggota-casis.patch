+<?php
+
+namespace App\Http\Controllers;
+
+use App\Models\Ekstrakurikuler;
+use App\Models\PendaftaranEkskul;
+use App\Models\User;
+use App\Services\OsisService;
+use App\Support\Pemberitahuan;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Gate;
+
+// Menunjuk dan mencabut senior penanggung jawab anggota. Hanya admin dan pembina ekskul itu (Gate kelola),
+// sama seperti penunjukan senior penilai di CaSis.
+class PenanggungJawabController extends Controller
+{
+    public function store(Request $request, Ekstrakurikuler $ekstrakurikuler, OsisService $osis)
+    {
+        Gate::authorize('kelola', $ekstrakurikuler);
+
+        $data = $request->validate(['user_id' => 'required|integer|exists:users,id'], ['user_id.required' => 'Pilih seniornya.']);
+        $user = User::findOrFail($data['user_id']);
+
+        // Sama seperti syarat senior CaSis: anggota aktif ekskul ini, atau organisasi di atasnya
+        $asal = $osis->idAsalPenilai($ekstrakurikuler);
+
+        $anggotaAktif = PendaftaranEkskul::anggotaAktif()
+            ->whereIn('ekstrakurikuler_id', $asal)
+            ->where('user_id', $user->id)
+            ->exists();
+
+        if (! $anggotaAktif) {
+            $tambahan = count($asal) > 1 ? ' (atau anggota organisasi di atasnya)' : '';
+
+            return back()->with('error', "Penanggung jawab harus anggota {$ekstrakurikuler->nama_ekstrakurikuler} yang masih aktif{$tambahan}.");
+        }
+
+        if ($ekstrakurikuler->penanggungJawabs()->where('users.id', $user->id)->exists()) {
+            return back()->with('error', "{$user->name} sudah menjadi penanggung jawab anggota.");
+        }
+
+        $ekstrakurikuler->penanggungJawabs()->attach($user->id, ['ditunjuk_oleh' => $request->user()->id]);
+
+        Pemberitahuan::kirim(
+            [$user],
+            'Ditunjuk sebagai penanggung jawab anggota',
+            "Kamu ditunjuk sebagai senior penanggung jawab anggota {$ekstrakurikuler->nama_ekstrakurikuler}. Kamu bisa mengatur kuota, menyetujui pendaftar, dan mengeluarkan anggota (alasan wajib).",
+            route('ekstrakurikuler.show', ['id' => $ekstrakurikuler->id, 'tab' => 'anggota'], false),
+            '🛡️',
+            $request->user()->id
+        );
+
+        return back()->with('success', "{$user->name} ditunjuk sebagai penanggung jawab anggota.");
+    }
+
+    public function destroy(Request $request, Ekstrakurikuler $ekstrakurikuler, User $user)
+    {
+        Gate::authorize('kelola', $ekstrakurikuler);
+
+        if ($ekstrakurikuler->penanggungJawabs()->detach($user->id) === 0) {
+            return back()->with('error', "{$user->name} bukan penanggung jawab anggota ekskul ini.");
+        }
+
+        Pemberitahuan::kirim(
+            [$user],
+            'Penugasan penanggung jawab anggota dicabut',
+            "Penugasanmu sebagai penanggung jawab anggota {$ekstrakurikuler->nama_ekstrakurikuler} sudah dicabut.",
+            route('ekstrakurikuler.show', ['id' => $ekstrakurikuler->id], false),
+            '🛡️',
+            $request->user()->id
+        );
+
+        return back()->with('success', "Penugasan {$user->name} sebagai penanggung jawab anggota dicabut.");
+    }
+}
