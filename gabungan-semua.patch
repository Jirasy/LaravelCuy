+    public static function selesaikan(?string $nama): string
+    {
+        if ($nama !== null && isset(self::JALUR[$nama])) {
+            return $nama;
+        }
+
+        $bersih = str_replace("\u{FE0F}", '', (string) $nama);
+
+        return self::DARI_EMOJI[$bersih] ?? self::CADANGAN;
+    }
